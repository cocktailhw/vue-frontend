server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # Ingress(10.x 대역)를 프록시로 신뢰하고, X-Forwarded-For 헤더에서 실제 IP 추출
    # set_real_ip_from 10.0.0.0/8;
    # real_ip_header X-Forwarded-For;
    # real_ip_recursive on;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /debug-ip {
        default_type application/json;
        return 200 '{"remote_addr": "$remote_addr", "x_forwarded_for": "$http_x_forwarded_for", "x_real_ip": "$http_x_real_ip"}';
    }

    location /api/ {
        # Injected at container start from BACKEND_UPSTREAM
        proxy_pass __BACKEND_UPSTREAM__;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # SpringDoc Swagger UI — IP whitelist (extra rules via SWAGGER_WHITELIST_RULE)
    location /swagger-ui/ {
        allow 127.0.0.1;
        allow 10.0.0.0/8;
        ${SWAGGER_WHITELIST_RULE}
        deny all;

        proxy_pass __BACKEND_UPSTREAM__;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # OpenAPI docs (JSON/YAML) — IP whitelist (extra rules via SWAGGER_WHITELIST_RULE)
    location /v3/api-docs/ {
        allow 127.0.0.1;
        allow 10.0.0.0/8;
        ${SWAGGER_WHITELIST_RULE}
        deny all;

        proxy_pass __BACKEND_UPSTREAM__;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Exact /v3/api-docs (no trailing slash) — same whitelist
    location = /v3/api-docs {
        allow 127.0.0.1;
        allow 10.0.0.0/8;
        ${SWAGGER_WHITELIST_RULE}
        deny all;

        proxy_pass __BACKEND_UPSTREAM__;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
